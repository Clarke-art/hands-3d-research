    },
    "face_ownership": {
      "Stage6A": "Historical face-centroid ownership / target-digit decomposition; contaminated cap-derived selector context",
      "targeted_R1": "Frozen fresh bounded pure-face THUMB/INDEX labels; no old cut-component split. Domain labels do not imply illegal driver or physical mesh separation."
    },
    "shared_vertex_exclusion": "Both exclude faces sharing a vertex. All three specified pairs share no vertices.",
    "crossing_definition": {
      "Stage6A": "BVHTree nonadjacent polygon overlap, epsilon0, new-vs-bind; not a penetration-depth classifier",
      "V2": "Real triangle crossings from actual triangulated polygons, same frozen triangulation, local rays and segment endpoints"
    },
    "penetration_proxy": {
      "Stage6A": "min of absolute centroid-to-other-face plane distances; .5mm practical visibility band for Human Review",
      "V2": "max footprint-constrained vertex-to-opposing-plane poke on an intersecting triangle pair; cp-to-foot tolerance1e-6m; limit2*local max edge; NOT minimum translation distance, overlap thickness, or physical body penetration depth"
    },
    "local_facet_scale": {
      "Stage6A": "No facet normalization; .5/.2mm counts diagnostic",
      "V2": "Mean bind triangle-edge length averaged over same face-pair triangle combinations; ClassA ratio>=1.0"
    },
    "visibility_severity": {
      "Stage6A": "Diagnostic contact counts including depths>.5mm retained for Human Review",
      "V2": "Geometric visibility proxy class; prior report also used full surfaces/strain to identify a separate torn flap, not triangle ClassA alone"
    },
    "blocking_semantics": {
      "Stage6A": "Cross-digit isolated-flex pose contacts PASS_WITH_HUMAN_REVIEW; machine hard blockers NaN/collapse/degenerate/clean-shaft motion/topology etc.",
      "historical_V2": "HUMAN_REVIEW_EVIDENCE_ONLY; genuine gross distal flap identified from large local stretch/hard flips plus solid views. Not blanket authority that every later isolated pose ClassA means skin failure.",
      "targeted_R1": "Escalated three ClassA observations to FAIL_CLOSED; conservative hold valid pending adjudication, but local skin/rig defect causality not established by that label."
    }
  },
  "V2_rule_unchanged": {
    "depth_measure": "footprint-constrained poke depth: the largest perpendicular distance of a vertex of one triangle from the other triangle's plane, counted only when that vertex projects INSIDE the other triangle",
    "scale_reference": "the BIND (undeformed) mesh mean edge length of the SAME triangle pair; mesh median edge = 3.8882 mm",
    "CASE_C_PROXY_OVER_ESTIMATION": "no real triangle/triangle crossing is found for the pair",
    "CASE_A_VISIBLE_GEOMETRIC_INTERPENETRATION": "real crossing AND depth >= 1.0 x the pair's own mean edge length (the sheets pass through each other by more than one facet of the mesh's own resolution)",
    "CASE_B_SURFACE_CONTACT_OR_NEAR_CONTACT": "real crossing AND depth < 1.0 x the pair's own mean edge length (the sheets touch / graze; the crossing is within the mesh's own facet resolution)"
  },
